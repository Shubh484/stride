# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Configuration
POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_password
POSTGRES_DB=fitness_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database Connection URL (for Prisma)
# In host environment: localhost:5432
# In docker-compose container: postgres:5432
DATABASE_URL=postgresql://fitness_user:fitness_password@localhost:5432/fitness_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_social_fitness_jwt_key_32_chars_min!
JWT_EXPIRES_IN=7d
